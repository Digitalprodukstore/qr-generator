# QR Studio Pro — buyer-owned local/Preview configuration
# Copy this file to .env for local development.
# Never commit .env or paste real values into source code, issues, or documentation.

# Required for Admin authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
ADMIN_PIN=REPLACE_WITH_A_UNIQUE_PIN_OR_PASSPHRASE
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Required for Admin sessions, login rate limiting, and shared global settings
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REST_TOKEN

# Optional: used only by the Admin database-health diagnostic in this edition.
# This does not activate Dynamic QR management or analytics.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
